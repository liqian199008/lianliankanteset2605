{
  "engineVersion": "3.8.0",
  "platforms": ["wechatgame"],
  "packages": {
    "include": [],
    "exclude": []
  },
  "project": {
    "name": "星灵物语",
    "creatorVersion": "3.8.0",
    "useBuiltinAssets": false,
    "renderPipeline": "deferred",
    "canvas": {
      "width": 750,
      "height": 1334,
      "designResolution": {
        "width": 750,
        "height": 1334,
        "policy": "SHOW_ALL"
      }
    },
    "groupList": [
      {
        "name": "default",
        "id": 0
      },
      {
        "name": "UI",
        "id": 1
      },
      {
        "name": "Game",
        "id": 2
      },
      {
        "name": "Effect",
        "id": 3
      }
    ],
    "moduleConfig": {
      "shaders": true,
      "particles": true,
      "tween": true,
      "physics": false,
      "webview": false,
      "audio": true,
      "video": false,
      "spine": false,
      "dragonBones": false,
      "richText": true,
      "subContextView": true
    }
  },
  "wechatgame": {
    "appid": "wx_your_appid_here",
    "orientation": "portrait",
    "subpackages": [
      {
        "name": "stage1",
        "root": "assets/scenes/battle/"
      }
    ],
    "cloud": {
      "enabled": true,
      "env": "dev-cloud-env"
    },
    "openDataContext": "wechat-open-data",
    "friendRelation": true,
    "groupChat": true
  },
  "scripts": {
    "entry": "assets/scripts/core/GameManager.ts",
    "includes": [
      "assets/scripts/**/*.ts"
    ],
    "excludes": []
  }
}
